{
  "name": "nuvadesk",
  "private": true,
  "type": "module",
  "workspaces": [
    "core",
    "dashboard",
    "site"
  ],
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "typecheck": "npm run typecheck --workspaces",
    "test": "npm test --workspaces",
    "build": "npm run build -w dashboard -w site",
    "dev:dashboard": "npm run dev -w dashboard",
    "dev:site": "npm run dev -w site",
    "gen:types": "npm -w core run gen:types",
    "qa": "node qa/run.ts",
    "new-client": "node scripts/new-client.ts"
  }
}
