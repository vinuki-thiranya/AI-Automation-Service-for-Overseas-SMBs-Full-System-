{
  "name": "@recallo/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=26"
  },
  "scripts": {
    "start": "node src/main.ts",
    "dev": "node --watch src/main.ts",
    "typecheck": "tsc --noEmit -p .",
    "test": "vitest run",
    "gen:types": "json2ts -i ../config/client.schema.json -o src/config/client-config.ts --unreachableDefinitions --additionalProperties false --bannerComment \"// GENERATED from config/client.schema.json by 'npm run gen:types'. Do not edit by hand.\""
  },
  "dependencies": {
    "@anthropic-ai/sdk": "1.4.0",
    "@supabase/supabase-js": "2.118.0",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "fastify": "5.12.8",
    "luxon": "3.7.2",
    "openai": "7.50.0",
    "yaml": "2.9.1",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@types/luxon": "3.7.6",
    "@types/node": "26.6.6",
    "json-schema-to-typescript": "16.0.0",
    "typescript": "7.0.2",
    "vitest": "5.1.0"
  }
}
