              },
              "renameOutput": true,
              "outputKey": "booking.created"
            },
            {
              "conditions": {
                "options": { "caseSensitive": true, "typeValidation": "strict" },
                "combinator": "and",
                "conditions": [{ "leftValue": "={{ $json.body.event }}", "rightValue": "escalation.opened", "operator": { "type": "string", "operation": "equals" } }]
