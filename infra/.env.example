# Copy to infra/.env on the server; never commit .env.
# `make first-boot` generates POSTGRES_PASSWORD and N8N_ENCRYPTION_KEY if they are still CHANGE_ME.
# Keep comments on their own lines (inline comments can end up inside values).

# --- Domain and TLS -----------------------------------------------------------
# ops.<DOMAIN> → n8n, status.<DOMAIN> → Uptime Kuma
DOMAIN=recallo.ai
# Let's Encrypt account and expiry notices
ACME_EMAIL=you@recallo.ai
# Cloudflare token with Zone:DNS:Edit on this zone only (Caddy DNS-01 challenge)
CLOUDFLARE_API_TOKEN=CHANGE_ME
# Cron schedule and n8n default timezone
TZ=Asia/Colombo

# --- n8n and its Postgres -------------------------------------------------------
POSTGRES_DB=n8n
POSTGRES_USER=n8n
POSTGRES_PASSWORD=CHANGE_ME
# LOSE THIS = LOSE EVERY STORED CREDENTIAL. Copy it into your password manager after first boot.
N8N_ENCRYPTION_KEY=CHANGE_ME
# 14 days of execution history
N8N_EXECUTIONS_MAX_AGE_HOURS=336
# Create in the n8n UI (Settings → n8n API) after first boot, then run `make bootstrap`
N8N_API_KEY=

# --- Backups → Backblaze B2 ---------------------------------------------------
B2_BUCKET=recallo-backups
# Application key restricted to the bucket above (read + write)
B2_KEY_ID=CHANGE_ME
B2_APPLICATION_KEY=CHANGE_ME
BACKUP_PREFIX=recallo
BACKUP_RETENTION_DAYS=30
# Optional: Uptime Kuma "Push" monitor URL (http://uptime-kuma:3001/api/push/<token>); pinged after each good backup
BACKUP_PUSH_URL=
# Optional: Supabase connection string for nightly client-data dumps (session pooler or direct, port 5432)
# postgresql://postgres.<project-ref>:<password>@<host>:5432/postgres
SUPABASE_DB_URL=

# --- Workflow export → Git ----------------------------------------------------
# Deploy key lives at infra/secrets/deploy_key (first-boot creates it; add the .pub to GitHub with write access)
GIT_REPO_SSH=git@github.com:vinuki-thiranya/AI-Automation-Service-for-Overseas-SMBs-Full-System-.git
GIT_BRANCH=main
GIT_AUTHOR_NAME=recallo-backup
GIT_AUTHOR_EMAIL=backup@recallo.ai

# --- Alerts → Telegram ----------------------------------------------------------
# Bot token from @BotFather, and the ID of your alerts chat or group
TELEGRAM_BOT_TOKEN=CHANGE_ME
TELEGRAM_CHAT_ID=CHANGE_ME

# --- recallo-core (Phase 2) -----------------------------------------------------
# Signs web chat sessions and derives per-client lead-form / webhook verify tokens. Generated by first-boot.
# Rotating it invalidates every lead-form URL and the WhatsApp verify tokens: re-run new-client.ts after.
CORE_SECRET=CHANGE_ME
# Bearer token n8n uses to call /v1/jobs/* and core uses for client event webhooks. Generated by first-boot.
CORE_JOB_TOKEN=CHANGE_ME
# Meta app → Settings → Basic → App secret (verifies X-Hub-Signature-256 on WhatsApp webhooks)
META_APP_SECRET=
# Graph API version for WhatsApp Cloud API calls
WHATSAPP_GRAPH_VERSION=v26.0
# Google Cloud OAuth client (Calendar + Sheets). Per-client refresh tokens live in Supabase Vault.
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Supabase projects by region (service-role keys: server-side only). Add EU/US when a client there signs.
SUPABASE_AU_URL=
SUPABASE_AU_SERVICE_ROLE_KEY=
SUPABASE_EU_URL=
SUPABASE_EU_SERVICE_ROLE_KEY=
SUPABASE_US_URL=
SUPABASE_US_SERVICE_ROLE_KEY=
