# Local credentials for live QA and integration checks. Copy to .env.local (gitignored) and fill in.
# Never commit .env.local, never paste these values into chat or issues.
#   npm run qa -- --live                         uses ANTHROPIC_API_KEY (+ OPENAI_API_KEY for retrieval/fallback runs)
#   node scripts/check-integrations.ts [--write]  checks whatever is filled in; empty = skipped
#   node scripts/google-oauth.ts                  fills GOOGLE_REFRESH_TOKEN for you

# --- Models -------------------------------------------------------------------
# Anthropic Console → a workspace for agency testing with a monthly spend limit → API key
ANTHROPIC_API_KEY=
# OpenAI → a project for agency testing with a monthly budget → project key
OPENAI_API_KEY=

# --- Google Calendar + Sheets -----------------------------------------------------
# Google Cloud → APIs & Services: enable Calendar API + Sheets API, OAuth client type "Desktop app"
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_OAUTH_CLIENT_SECRET=
# Written by `node scripts/google-oauth.ts` (don't paste it by hand)
GOOGLE_REFRESH_TOKEN=
# A throwaway calendar for tests (Calendar settings → Integrate calendar → Calendar ID)
TEST_CALENDAR_ID=
# A throwaway spreadsheet (the long id in its URL); the check writes to a tab named QA
TEST_SHEET_ID=

# --- Telegram (ops alerts) -----------------------------------------------------------
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# --- Later: messaging and practice systems (checks are skipped while empty) ---------
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
WHATSAPP_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
RESEND_API_KEY=
CLINIKO_API_KEY=
